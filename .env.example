NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/capstone"

# Must be at least 32 characters
JWT_SECRET=replace-with-at-least-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Use different values for access and refresh secrets (each at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_SECRET=replace-with-another-unique-32-char-secret

# OPENAI_API_KEY=
# REDIS_URL=redis://localhost:6379
