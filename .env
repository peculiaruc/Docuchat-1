# SQLite (development) - no poll needed, it is file- based
DATABASE_URL="sqlite:///./dev.db"

# PostgreSQL (production) - pool configuration
DATABASE_URL=postgresql://user:password@localhost:5432/capston?connecttion_limit=0
&pool_timeout=10

# coonection_limit: max connection in the pool (default: num_cpus*2 + 1)
#pool_timeout: secondsa to wait for a connection before error (default: 10)