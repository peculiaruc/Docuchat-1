generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model user {
    id             String @id @default(cuid())
    name           String
    email          String
    passwordHash   String
    role           String
    tier           String
    isActive       String
    deletedAt      String
    createdAt      String
    updatedAt      String

    @@index([email])
}

model Document {
    id      String @id @default(cuid())
    userId  String
    status  String

    @@index([userId])
    @@index([status])
    @@index([userId, status])
}
