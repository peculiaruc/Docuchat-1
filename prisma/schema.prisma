generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model user {
    id             String    @id @default(cuid())
    name           String
    email          String    @unique
    passwordHash   String
    role           String    @default("USER")
    tier           String    @default("FREE")
    isActive       Boolean   @default(true)
    deletedAt      DateTime?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    refreshTokens  RefreshToken[]
}

model RefreshToken {
    id        String   @id @default(cuid())
    token     String   @unique
    userId    String
    expiresAt DateTime
    createdAt DateTime @default(now())
    user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
}

model Document {
    id      String @id @default(cuid())
    userId  String
    status  String

    @@index([userId])
    @@index([status])
    @@index([userId, status])
}
